# Configuration for `docker compose` (copy to .env). The local development servers read backend/.env
# instead (see backend/.env.example). The main settings are explained in README.md.

# ---- Required ----
# Public address of the site, with scheme and no trailing slash. Used in emails and CSRF checks.
SITE_URL=http://localhost:8080
# Long random value, e.g.  openssl rand -base64 48   (changing it signs everyone out)
DJANGO_SECRET_KEY=
# Database password. Keep it URL-safe (letters and digits): it is embedded in DATABASE_URL.
POSTGRES_PASSWORD=
# Hostnames the API answers to, comma separated (a leading dot also matches subdomains).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---- HTTPS ----
# The defaults below let you try Doory over plain http://localhost. Behind a TLS-terminating proxy
# (production), set both to true.
SECURE_SSL_REDIRECT=false
SECURE_COOKIES=false
# Reverse proxies between the internet and the API, as seen by rate limiting (bundled nginx = 1;
# add one for each extra proxy that does not rewrite X-Forwarded-For).
NUM_PROXIES=1

# ---- AI design assistant ----
# CLI providers are only available in self-host mode. They still need explicit enablement and staff login.
DOORY_SELF_HOSTED=false
# Administrator-owned provider configuration, JSON. See docs/ai-assistant.md.
DOORY_AI_PROVIDERS={}
DOORY_AI_TIMEOUT=90

# ---- Ports and build options ----
WEB_PORT=8080
# Interface the web port is published on. Use 127.0.0.1 when a reverse proxy on the same host fronts it.
WEB_BIND=0.0.0.0
# Build headless Chromium into the API image for server-side PDF export (adds ~400 MB). false = off.
INSTALL_CHROMIUM=true

# ---- Optional: first-run content (the commands are listed in README.md) ----
# Without it a new site has no icons, emoji or illustrations, no fonts besides the system ones and no
# background-removal model. These flags run the downloads inside the API container *before* it starts
# serving; a failed download is logged and never stops the server. The first start can take minutes
# (Compose reports the API as unhealthy for as long as it takes), so for a first install you may prefer
# `docker compose exec api python manage.py ...` once the stack is up, and these flags afterwards.
# Template categories: docker compose exec api python manage.py seed_gallery

# Element library (icons, emoji, illustrations, shapes, graphics): about 25 000 elements,
# about 40 s and 110-125 MB on disk the first time, a second afterwards. true: run on every start.
DOORY_SYNC_ELEMENTS=false
# Extra arguments for `manage.py sync_element_packs`, e.g. --pack lucide phosphor-regular
DOORY_SYNC_ELEMENTS_ARGS=

# Font catalog (OFL fonts from Fontsource via jsDelivr). true: download once, on the first start.
DOORY_SYNC_FONTS=false
# Which families (default when empty: the 100 most popular, about 6 MB). e.g. --popular 253 or --all
DOORY_SYNC_FONTS_ARGS=

# The ten starter templates (backend/data/templates, with thumbnails). true: add them on every start. Add-only:
# a template that already exists is never changed, so edits made in the admin survive. Needs the fonts above.
DOORY_SEED_TEMPLATES=false

# Background-removal model (U2-Net small, Apache-2.0, 4.6 MB, into MEDIA_ROOT/models/). true: run on every
# start (an installed model costs a hash check, no download).
DOORY_SYNC_MODELS=false
# Extra arguments for `manage.py sync_models`, e.g. --model u2net (176 MB) or --all
DOORY_SYNC_MODELS_ARGS=

# Audio library (24 music loops and 88 sound effects, CC0, about 7 MB, into MEDIA_ROOT/audio/): installed from the
# files in the image, no download. true: run on every start (installed files cost a hash check).
DOORY_SYNC_AUDIO=false
# Extra arguments for `manage.py sync_audio`, e.g. --pack some-pack (optional CC0 packs listed in the manifest)
DOORY_SYNC_AUDIO_ARGS=

# ---- Optional: email (default prints emails to the container log) ----
# EMAIL_URL=smtp+tls://user:password@smtp.example.com:587
# DEFAULT_FROM_EMAIL=Doory <no-reply@example.com>

# ---- Optional: Google sign-in (OAuth web client ID) ----
# GOOGLE_CLIENT_ID=

# ---- Optional: stock photo search ----
# UNSPLASH_ACCESS_KEY=
# PEXELS_API_KEY=

# ---- Optional: S3-compatible media storage instead of the local volume ----
# USE_S3=true
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_ENDPOINT_URL=
# AWS_S3_REGION_NAME=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
